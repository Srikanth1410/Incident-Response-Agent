# PayRecall Agent Configuration
# Copy this file to .env and fill in your real keys.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose: "groq" or "openai"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# ── API Keys (fill in one) ─────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ── Backend ────────────────────────────────────────────────────────────────────
# The Go backend REST API base URL
BACKEND_URL=http://localhost:8080

# ── MCP Server ────────────────────────────────────────────────────────────────
# Optional: override the path to the compiled Go MCP binary
# MCP_SERVER_BINARY=C:\Users\maree\Desktop\PayRecall\mcp-server\mcp-server.exe

# ── Hindsight Memory ───────────────────────────────────────────────────────────
# Option A: Self-hosted (run Hindsight locally via Docker)
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=payrecall

# Option B: Hindsight Cloud (comment out BASE_URL above, uncomment below)
# HINDSIGHT_BASE_URL=https://api.hindsight.so
# HINDSIGHT_API_KEY=your_hindsight_cloud_api_key_here
